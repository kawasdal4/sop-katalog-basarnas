{
  "$schema": "../gen/schemas/capability.json",
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "remote": {
    "urls": ["https://e-katalog-sop.cloud/*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "schemes": ["http", "https", "mailto", "tel"] },
        { "url": "https://pub-a6302a3a22854799b35a15cd40f9c728.r2.dev/*" },
        { "url": "https://*.sharepoint.com/*" },
        { "url": "https://*.onedrive.live.com/*" },
        { "url": "https://*.office.com/*" }
      ]
    },
    "notification:default",
    "clipboard-manager:default",
    "sql:default",
    "log:default",
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "**" }]
    }
  ]
}


